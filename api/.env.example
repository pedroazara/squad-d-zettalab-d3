# Copie para api/.env local (nao versionar) se quiser.
# Com Docker Compose da raiz em execucao:
# docker compose up -d postgres

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/guarawatch
JWT_SECRET=change-me-in-production-with-at-least-32-bytes
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=120
# Lista separada por virgula. Exemplo de producao:
# CORS_ALLOW_ORIGINS=https://seu-frontend.onrender.com,https://www.seu-dominio.com
CORS_ALLOW_ORIGINS=http://127.0.0.1:4173,http://localhost:4173,http://127.0.0.1:5173,http://localhost:5173
